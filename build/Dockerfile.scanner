FROM mcr.microsoft.com/dotnet/sdk:10.0

# Install Java (required for SonarScanner)
RUN apt-get update && \
	apt-get install -y --no-install-recommends openjdk-17-jdk unzip wget && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/* && \
	groupadd --system appgroup && \
	useradd --system --create-home --gid appgroup appuser && \
	mkdir -p /source /work /home/appuser/.dotnet/tools /home/appuser/.nuget/packages && \
	chown -R appuser:appgroup /work /home/appuser && \
	chmod 755 /source
ENV HOME=/home/appuser
ENV NUGET_PACKAGES=/home/appuser/.nuget/packages
ENV PATH="${PATH}:/home/appuser/.dotnet/tools"
USER appuser
WORKDIR /source

# Install SonarScanner for .NET and ReportGenerator for coverage
RUN dotnet tool install --global dotnet-sonarscanner \
	&& dotnet tool install --global dotnet-reportgenerator-globaltool

# Copy solution and project files
COPY --chmod=444 ["OrderManagement.sln", "./"]
COPY --chmod=444 ["src/API/OrderManagement.API/OrderManagement.API.csproj", "src/API/OrderManagement.API/"]
COPY --chmod=444 ["src/Application/OrderManagement.Application/OrderManagement.Application.csproj", "src/Application/OrderManagement.Application/"]
COPY --chmod=444 ["src/Domain/OrderManagement.Domain/OrderManagement.Domain.csproj", "src/Domain/OrderManagement.Domain/"]
COPY --chmod=444 ["src/Infrastructure/OrderManagement.Infrastructure/OrderManagement.Infrastructure.csproj", "src/Infrastructure/OrderManagement.Infrastructure/"]
COPY --chmod=444 ["tests/OrderManagement.UnitTests/OrderManagement.UnitTests.csproj", "tests/OrderManagement.UnitTests/"]
COPY --chmod=444 ["tests/OrderManagement.IntegrationTests/OrderManagement.IntegrationTests.csproj", "tests/OrderManagement.IntegrationTests/"]
RUN cp -R /source/. /work/ \
	&& chmod -R u+w /work

# Restore dependencies
WORKDIR /work
RUN dotnet restore "OrderManagement.sln"

# Copy application and test source only
WORKDIR /source
COPY --chmod=555 ["src/", "src/"]
COPY --chmod=555 ["tests/", "tests/"]
RUN cp -R /source/src/. /work/src/ \
	&& cp -R /source/tests/. /work/tests/ \
	&& chmod -R u+w /work/src /work/tests
WORKDIR /work

# Create a script to run the analysis
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "Starting SonarQube analysis..."\n\
\n\
# Begin SonarScanner\n\
dotnet sonarscanner begin \\\n\
  /k:"${SONAR_PROJECT_KEY}" \\\n\
  /n:"${SONAR_PROJECT_NAME}" \\\n\
  /v:"${SONAR_PROJECT_VERSION}" \\\n\
  /d:sonar.host.url="${SONAR_HOST_URL}" \\\n\
  /d:sonar.token="${SONAR_TOKEN}" \\\n\
  /d:sonar.cs.opencover.reportsPaths="TestResults/**/coverage.opencover.xml" \\\n\
  /d:sonar.coverage.exclusions="**/Program.cs,**/Migrations/*.cs,**/*Tests/**,**/*Test.cs,**/DatabaseMigrationExtensions.cs,**/OpenTelemetryExtensions.cs,**/DTOs/**,**/Entities/**" \\\n\
  /d:sonar.exclusions="**/Migrations/**,**/obj/**,**/bin/**"
\n\
# Build the solution\n\
dotnet build OrderManagement.sln --configuration Release --no-restore\n\
\n\
# Run tests with coverage\n\
dotnet test OrderManagement.sln \\\n\
  --configuration Release \\\n\
  --no-build \\\n\
  --collect:"XPlat Code Coverage" \\\n\
  --results-directory ./TestResults \\\n\
  -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=opencover\n\
\n\
# End SonarScanner\n\
dotnet sonarscanner end /d:sonar.token="${SONAR_TOKEN}"\n\
\n\
echo "SonarQube analysis completed!"\n\
' > /home/appuser/run-analysis.sh && chmod +x /home/appuser/run-analysis.sh

# Set entrypoint
ENTRYPOINT ["/home/appuser/run-analysis.sh"]
