FROM mcr.microsoft.com/dotnet/sdk:10.0

# Install Java (required for SonarScanner)
RUN apt-get update && \
	apt-get install -y --no-install-recommends openjdk-17-jdk unzip wget && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/*

RUN groupadd --system appgroup \
	&& useradd --system --create-home --gid appgroup appuser \
	&& mkdir -p /src /home/appuser/.dotnet/tools /home/appuser/.nuget/packages \
	&& chown -R appuser:appgroup /src /home/appuser
ENV HOME=/home/appuser
ENV NUGET_PACKAGES=/home/appuser/.nuget/packages
ENV PATH="${PATH}:/home/appuser/.dotnet/tools"
WORKDIR /src
USER appuser

# Install SonarScanner for .NET
RUN dotnet tool install --global dotnet-sonarscanner

# Install ReportGenerator for coverage
RUN dotnet tool install --global dotnet-reportgenerator-globaltool

# Copy solution and project files
COPY --chown=appuser:appgroup ["OrderManagement.sln", "./"]
COPY --chown=appuser:appgroup ["src/API/OrderManagement.API/OrderManagement.API.csproj", "src/API/OrderManagement.API/"]
COPY --chown=appuser:appgroup ["src/Application/OrderManagement.Application/OrderManagement.Application.csproj", "src/Application/OrderManagement.Application/"]
COPY --chown=appuser:appgroup ["src/Domain/OrderManagement.Domain/OrderManagement.Domain.csproj", "src/Domain/OrderManagement.Domain/"]
COPY --chown=appuser:appgroup ["src/Infrastructure/OrderManagement.Infrastructure/OrderManagement.Infrastructure.csproj", "src/Infrastructure/OrderManagement.Infrastructure/"]
COPY --chown=appuser:appgroup ["tests/OrderManagement.UnitTests/OrderManagement.UnitTests.csproj", "tests/OrderManagement.UnitTests/"]
COPY --chown=appuser:appgroup ["tests/OrderManagement.IntegrationTests/OrderManagement.IntegrationTests.csproj", "tests/OrderManagement.IntegrationTests/"]

# Restore dependencies
RUN dotnet restore "OrderManagement.sln"

# Copy application and test source only
COPY --chown=appuser:appgroup ["src/", "src/"]
COPY --chown=appuser:appgroup ["tests/", "tests/"]

# Create a script to run the analysis
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "Starting SonarQube analysis..."\n\
\n\
# Begin SonarScanner\n\
dotnet sonarscanner begin \\\n\
  /k:"${SONAR_PROJECT_KEY}" \\\n\
  /n:"${SONAR_PROJECT_NAME}" \\\n\
  /v:"${SONAR_PROJECT_VERSION}" \\\n\
  /d:sonar.host.url="${SONAR_HOST_URL}" \\\n\
  /d:sonar.token="${SONAR_TOKEN}" \\\n\
  /d:sonar.cs.opencover.reportsPaths="**/coverage.opencover.xml" \\\n\
  /d:sonar.coverage.exclusions="**/Program.cs,**/Migrations/**,**/*Tests/**" \\\n\
  /d:sonar.exclusions="**/Migrations/**,**/obj/**,**/bin/**"\n\
\n\
# Build the solution\n\
dotnet build OrderManagement.sln --configuration Release --no-restore\n\
\n\
# Run tests with coverage\n\
dotnet test OrderManagement.sln \\\n\
  --configuration Release \\\n\
  --no-build \\\n\
  --collect:"XPlat Code Coverage" \\\n\
  --results-directory ./TestResults \\\n\
  -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=opencover\n\
\n\
# End SonarScanner\n\
dotnet sonarscanner end /d:sonar.token="${SONAR_TOKEN}"\n\
\n\
echo "SonarQube analysis completed!"\n\
' > /home/appuser/run-analysis.sh && chmod +x /home/appuser/run-analysis.sh

# Set entrypoint
ENTRYPOINT ["/home/appuser/run-analysis.sh"]
